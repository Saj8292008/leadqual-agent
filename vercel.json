{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/cron/drip", "schedule": "0 15 * * *" },
    { "path": "/cron/transaction-reminders", "schedule": "0 14 * * *" },
    { "path": "/cron/property-reminders", "schedule": "5 14 * * *" }
  ]
}
