PORT=3000

# Claude (conversation brain)
ANTHROPIC_API_KEY=

# AgentMail (email channel) — https://agentmail.to
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Google Calendar (showing booking) — service account
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
AGENT_CALENDAR_ID=agent@example.com
AGENT_TIMEZONE=America/Chicago

# Shared webhook secret — lead intake sources must send this in X-Webhook-Secret
LEAD_WEBHOOK_SECRET=change-me

# How many days of no reply before a lead is dropped into long-term nurture
NURTURE_DRIP_DAYS=3
