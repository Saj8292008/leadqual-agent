PORT=3000

# Conversation brain. "anthropic" (default) uses Claude and trusts its forced
# tool_choice directly. "ollama" runs a local model instead — no API cost, but
# less reliable at following the exact output schema, so those calls are
# validated and retried (see src/services/llm.js).
LLM_PROVIDER=anthropic

# Claude (conversation brain)
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# AgentMail (email channel) — https://agentmail.to
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Google Calendar (showing booking) — service account
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
AGENT_CALENDAR_ID=agent@example.com
AGENT_TIMEZONE=America/Chicago

# Slack alert when a lead needs a human (handoff) — Slack Incoming Webhook URL
HANDOFF_SLACK_WEBHOOK_URL=

# Shared webhook secret — lead intake sources must send this in X-Webhook-Secret
LEAD_WEBHOOK_SECRET=change-me

# Shared secret for internal inspection/management routes (GET /leads, GET /listings,
# regenerate, publish). Send as X-Admin-Secret header, or ?key= for the flyer link.
ADMIN_SECRET=change-me-too

# How many days of no reply before a lead is dropped into long-term nurture
NURTURE_DRIP_DAYS=3

# How many days out from a transaction milestone deadline to start reminding
MILESTONE_REMINDER_DAYS=3

# Property management: rent reminder window and overdue grace period (days)
RENT_REMINDER_DAYS=3
RENT_OVERDUE_GRACE_DAYS=3
